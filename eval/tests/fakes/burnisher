#!/usr/bin/env python3
"""A stand-in for the native runtime that speaks the BURNISH_JSON protocol.

Latency is a deterministic function of (stage, impl, resolution) plus a small seeded wobble, so a
test can ask for a known speedup and check the harness reports it. Nothing here computes anything;
it exists to exercise the runner's guards, pairing and parsing.

Knobs a test can set:
  BURNISH_FAKE_SPEEDUP   candidate impl runs this many times faster
  BURNISH_FAKE_WOBBLE    relative run-to-run spread
  BURNISH_FAKE_FALLBACK  report `stock` whatever was asked for -- the silent-fallback incident
  BURNISH_FAKE_DEGENERATE  report a constant output latent
  BURNISH_FAKE_NO_JSON   print prose and no result line
  BURNISH_FAKE_COUNTER   path to a call-counter file, so repeats differ from each other
  BURNISH_FAKE_DRIFT     how far a non-stock impl's latents sit from stock's
  BURNISH_FAKE_FLAKY     perturb every generation, so the determinism check fails
"""
import hashlib
import json
import os
import sys

import numpy as np

args = sys.argv[1:]
if not args or "--help" in args:
    print("fake burnisher: info | bench | generate | probe")
    sys.exit(0)

opt = {}
i = 1
while i < len(args):
    if args[i].startswith("--"):
        key = args[i][2:]
        if i + 1 < len(args) and not args[i + 1].startswith("--"):
            opt[key] = args[i + 1]
            i += 2
        else:
            opt[key] = "1"
            i += 1
    else:
        i += 1

if args[0] == "info":
    print("fake burnisher\ncuda: fake")
    sys.exit(0)

if args[0] == "generate":
    # A deterministic latent keyed by (token ids, noise, seed, impl), so replays of one build are
    # byte-identical and two builds differ by a controllable amount. Keyed by the IDS and the
    # NOISE rather than a prompt string, because that is what the real runtime takes -- a fake
    # that accepted a different interface would let the real one drift away from its harness.
    #   BURNISH_FAKE_DRIFT   how far the candidate impl sits from `stock`
    #   BURNISH_FAKE_FLAKY   perturb every call, so the determinism check fails
    ids_path = opt.get("token-ids", "")
    noise_path = opt.get("noise", "")
    prompt = ""
    for path in (ids_path, noise_path):
        if path and os.path.exists(path):
            with open(path, "rb") as fh:
                prompt += hashlib.sha256(fh.read()).hexdigest()
    seed = int(opt.get("seed", 0))
    impl = opt.get("impl", "stock")
    h = int(hashlib.sha256(f"{prompt}:{seed}".encode()).hexdigest()[:8], 16)
    rng = np.random.default_rng(h)
    latent = rng.standard_normal((1, 4, 16, 16)).astype(np.float32)
    if impl != "stock":
        drift = float(os.environ.get("BURNISH_FAKE_DRIFT", "0.0"))
        latent = latent + drift * np.linalg.norm(latent) / latent.size * rng.standard_normal(
            latent.shape).astype(np.float32)
    if os.environ.get("BURNISH_FAKE_FLAKY"):
        latent = latent + np.float32(1e-3) * np.random.default_rng().standard_normal(
            latent.shape).astype(np.float32)
    out = opt.get("dump-latents")
    if out:
        np.save(out, latent)
    print("BURNISH_JSON: " + json.dumps({
        "metrics": {"latency_s": 0.5, "peak_vram_bytes": 11_000_000_000},
        "effective": {"impl": impl, "seed": str(seed)},
        "output_stats": {"latent_mean": float(latent.mean()),
                         "latent_std": float(latent.std()),
                         "latent_absmax": float(np.abs(latent).max())},
    }))
    sys.exit(0)

if os.environ.get("BURNISH_FAKE_NO_JSON"):
    print("ran fine, it was quite fast")
    sys.exit(0)

stage = opt.get("stage", "dit-step")
impl = opt.get("impl", "stock")
repeat = opt.get("seed", "0")
_here = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(_here, "latencies.json")) as fh:
    _lat = json.load(fh)
base = _lat.get(stage, 0.1)
base *= float(opt.get("resolution", 1024)) / 1024.0

if impl != "stock":
    base /= float(os.environ.get("BURNISH_FAKE_SPEEDUP", "1.0"))

# Real hardware varies between identical invocations; a deterministic stub does not, and a stub
# that did not vary would make every measured noise floor come out as the instrument resolution.
# A counter file keeps the wobble varying per call AND reproducible across a test run.
wobble = float(os.environ.get("BURNISH_FAKE_WOBBLE", "0.002"))
call = 0
counter = os.environ.get("BURNISH_FAKE_COUNTER")
if counter:
    try:
        with open(counter) as fh:
            call = int(fh.read().strip() or 0)
    except OSError:
        call = 0
    with open(counter, "w") as fh:
        fh.write(str(call + 1))
key = f"{stage}:{impl}:{repeat}:{call}"
h = int(hashlib.sha256(key.encode()).hexdigest()[:8], 16)
base *= 1.0 + wobble * ((h % 1000) / 500.0 - 1.0)

reported = "stock" if os.environ.get("BURNISH_FAKE_FALLBACK") else impl
stats = {"latent_mean": -0.02, "latent_std": 1.1, "latent_absmax": 4.3}
if os.environ.get("BURNISH_FAKE_DEGENERATE"):
    stats = {"latent_mean": 0.0, "latent_std": 0.0, "latent_absmax": 0.0}

print("BURNISH_JSON: " + json.dumps({
    "metrics": {"latency_s": base, "peak_vram_bytes": 11_000_000_000, "iters": 10},
    "effective": {"stage": stage, "dtype": opt.get("dtype", "bf16"), "impl": reported,
                  "resolution": opt.get("resolution", "1024"),
                  "batch": opt.get("batch", "2"),
                  "caption_len": opt.get("caption-len", "300"),
                  # Echoed because the harness CHECKS it: an arm that ran somewhere other than
                  # where it was asked to is the same class of fault as one that ran a different
                  # kernel, and neither is visible from outside the process.
                  "device": opt.get("device", "cpu")},
    "output_stats": stats,
}))
